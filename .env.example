NODE_ENV=development
PORT=9000
PEEROVO_HOST=0.0.0.0
PEEROVO_PUBLIC_HOST=127.0.0.1
PEEROVO_PUBLIC_PORT=9000
PEEROVO_PUBLIC_SECURE=false
PEEROVO_PATH=/
PEEROVO_KEY=peerjs
PEEROVO_PROXIED=false
PEEROVO_TRUST_PROXY=false
PEEROVO_SIGNING_SECRET=replace-with-at-least-32-random-bytes
PEEROVO_PROJECT_SAMPLE_API_KEY=replace-with-a-different-32-byte-secret
PEEROVO_PROJECT_SAMPLE_ALLOWED_ORIGINS='["http://127.0.0.1:3000"]'
# Add a dedicated API key and origins variable for each additional project.
# PEEROVO_PROJECT_MY_NEW_APP_API_KEY=replace-with-a-separate-32-byte-secret
# PEEROVO_PROJECT_MY_NEW_APP_ALLOWED_ORIGINS='["https://app.example.com"]'
# Optional per-project concurrent peer limit (1-500; defaults to 60).
# PEEROVO_PROJECT_MY_NEW_APP_MAX_PEERS=60
TURN_DOMAIN=turndomain.com
TURN_SECRET_KEY=replace-with-coturn-static-auth-secret
TURN_PORT=443
TURNS_PORT=443
TURN_CREDENTIAL_TTL_SECONDS=120
PEEROVO_MAX_PEERS_PER_SESSION=30
PEEROVO_MAX_PEERS_PER_PROJECT=60
PEEROVO_MAX_SIGNALING_CONNECTIONS=5000
PEEROVO_TICKET_RATE_LIMIT=120
PEEROVO_ICE_RATE_LIMIT=120
PEEROVO_SIGNALING_RATE_LIMIT=120
PEEROVO_USAGE_LOG_INTERVAL_SECONDS=300
# PeerJS browser console logging: 0=off, 1=errors, 2=warnings, 3=all.
PEEROVO_PEERJS_DEBUG=0
